# Copiá este archivo como .env y poné adentro las claves reales.
# .env está en .gitignore: nunca viaja al repositorio.
#
# NO pegues las claves en el chat. Van solo acá.

# Replicate — anima las imágenes fijas (imagen a video).
# Se saca en replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# ElevenLabs — locución del Rey Mosquito y del oficial.
# Se saca en elevenlabs.com, en el perfil, sección API Keys.
ELEVENLABS_API_KEY=

# Ruta de ffmpeg. Winget lo instaló pero solo entra al PATH en terminales
# nuevas; con esto funciona igual desde cualquier sesión.
FFMPEG_PATH=C:\Users\oldec\AppData\Local\Microsoft\WinGet\Packages\Gyan.FFmpeg_Microsoft.Winget.Source_8wekyb3d8bbwe\ffmpeg-9.0.1-full_build\bin
